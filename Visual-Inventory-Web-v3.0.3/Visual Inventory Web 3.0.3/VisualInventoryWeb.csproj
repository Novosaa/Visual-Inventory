<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VisualInventoryWeb</AssemblyName>
    <RootNamespace>VisualInventory</RootNamespace>
    <Version>3.0.3</Version>
    <AssemblyVersion>3.0.3.0</AssemblyVersion>
    <FileVersion>3.0.3.0</FileVersion>
    <Company>NOVOSA</Company>
    <Product>Visual Inventory (web)</Product>
    <Description>View-only visual inventory of one Library folder, as a website. Reads only; writes nothing.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <!-- No extra packages: only what comes with .NET itself. -->
</Project>
