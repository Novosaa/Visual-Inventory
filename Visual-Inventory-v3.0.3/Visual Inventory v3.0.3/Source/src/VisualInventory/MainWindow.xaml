<Window x:Class="VisualInventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="Manual" Background="{StaticResource Paper}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar entries. The one you're looking at gets a pink bar and a lighter background. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D9D3DD" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3,0,0,0" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#312D34" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#3A353E" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource Pink}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverviewNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding OverviewIsCurrent}" Value="True">
                    <Setter Property="Background" Value="#3A353E" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource Pink}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Shows the file type (PDF, HTML, FOLDER…) only when there is no picture to show. -->
        <Style x:Key="TypePlaceholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B5ADA4" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,14,6" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: the project name, then every category (folder inside Library). -->
        <Border Grid.Column="0" Background="{StaticResource Ink}">
            <DockPanel>
                <!-- Side Eye build only: the logo across the top of the sidebar (shown from code). -->
                <Image x:Name="BrandLogo" DockPanel.Dock="Top" Visibility="Collapsed" Stretch="Uniform"
                       Margin="14,16,14,0" MaxHeight="130" HorizontalAlignment="Center" />
                <Grid DockPanel.Dock="Top" Margin="20,22,16,18">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="BadgeColumn" Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="PinkBadge" Width="38" Height="38" CornerRadius="8" Background="{StaticResource Pink}" VerticalAlignment="Top">
                        <TextBlock Text="◉" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
                    </Border>
                    <StackPanel x:Name="NameBlock" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProjectName}" FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Text="VISUAL INVENTORY" FontSize="9" FontWeight="Bold" Foreground="#AFA8B2" Margin="0,3,0,0" />
                        <TextBlock Text="v3.0.3 · view only" FontSize="9" FontWeight="Bold" Foreground="#E85D91" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                    <StackPanel Margin="12,0,10,8">
                        <TextBlock Text="YOUR LIBRARY" Foreground="#9A93A0" FontSize="9" FontWeight="Bold" Margin="15,0,0,6" />
                        <Button Content="Overview" Style="{StaticResource OverviewNavButton}" Tag="Overview" Click="Navigation_Click" />
                        <ItemsControl ItemsSource="{Binding DashboardSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Tag="{Binding Name}" ToolTip="{Binding Name}"
                                            Style="{StaticResource NavButton}" Click="Navigation_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="0,0,8,0" Height="36">
                        <TextBox x:Name="SearchBox" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource Border}"
                                 TextChanged="SearchBox_TextChanged" ToolTip="Search this category (Ctrl+F)" />
                        <TextBlock Text="Search this category" Foreground="#9A939D" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" x:Name="DetailsToggle" Content="Hide details" Style="{StaticResource QuietButton}" Click="DetailsToggle_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- No Library folder next to the app -->
                <Grid x:Name="MissingLibraryView" Visibility="Collapsed">
                    <Border Width="600" VerticalAlignment="Center" Padding="36" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <Border Width="58" Height="8" Background="{StaticResource Pink}" HorizontalAlignment="Left" Margin="0,0,0,20" />
                            <TextBlock Text="No Library folder found" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Margin="0,12,0,8" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                       Text="Visual Inventory shows the folder called Library that sits next to VisualInventory.exe. Make that folder in Explorer, put your category folders inside it, then press Refresh." />
                            <TextBlock Text="{Binding LibraryPathText}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20" />
                            <Button Content="Refresh" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="Refresh_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- OVERVIEW: the categories. -->
                <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto" Padding="28">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Your categories" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="Each folder inside Library is a category." Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastReadText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="Refresh" Style="{StaticResource QuietButton}" Click="Refresh_Click" ToolTip="Read the Library folder again (F5)" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="EmptyLibraryPanel" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Your Library is empty" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Put folders (your categories) and files into the Library folder in Explorer, then press Refresh." Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DashboardSections}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Name}" Click="Navigation_Click" Style="{StaticResource BareButton}" Margin="0,0,14,14">
                                        <Border Width="250" Height="96" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="5" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Border Background="{Binding Accent}" CornerRadius="2" />
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="16" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2" Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- CATEGORY VIEW -->
                <Grid x:Name="SectionView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="DetailsColumn" Width="340" MinWidth="260" MaxWidth="700" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding VisibleCountText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="28,14,28,0" />
                        <!-- Tiles stretch to fill the row (see UpdateTileSize); pictures are never smaller than before. -->
                        <ScrollViewer Grid.Row="1" x:Name="ItemsScroller" VerticalScrollBarVisibility="Visible" Padding="28,10,20,24"
                                      SizeChanged="ItemsScroller_SizeChanged">
                            <ItemsControl ItemsSource="{Binding VisibleItems}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="ItemCard_Click" Style="{StaticResource BareButton}" Margin="0,0,16,16">
                                            <Border Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=Window}}" Background="White" CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Pink}" />
                                                                <Setter Property="BorderThickness" Value="3" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="{Binding DataContext.TileImageRow, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{StaticResource TileBack}" CornerRadius="7,7,0,0">
                                                        <Grid>
                                                            <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource TypePlaceholder}" />
                                                            <Image Source="{Binding PreviewPath, Converter={StaticResource TileThumb}}" Stretch="Uniform" Margin="10" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="14,10,14,12" Height="76">
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SubText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <GridSplitter Grid.Column="1" x:Name="DetailsSplitter" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" Background="{StaticResource Border}" ToolTip="Drag to resize" />

                    <!-- DETAILS PANEL: the picture first, then what the file is. -->
                    <Border Grid.Column="2" x:Name="DetailsPanel" Background="White">
                        <Grid>
                            <TextBlock Text="Click a tile to see it here." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <StackPanel DataContext="{Binding SelectedItem}">
                                    <Border Background="{StaticResource TileBack}" CornerRadius="6" MinHeight="110">
                                        <Grid>
                                            <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource TypePlaceholder}" />
                                            <Image Source="{Binding PreviewPath, Converter={StaticResource LargeThumb}}" Stretch="Uniform" MaxHeight="420" Margin="8" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="20" TextWrapping="Wrap" Margin="0,16,0,2" />
                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Text="{Binding SubText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />

                                    <!-- file details (files only) -->
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedDetails, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid DataContext="{Binding DataContext.SelectedDetails, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Type" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Type}" Style="{StaticResource DetailValue}" />
                                            <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Size}" Style="{StaticResource DetailValue}" />
                                            <TextBlock Grid.Row="2" Text="Dimensions" Style="{StaticResource DetailLabel}" Visibility="{Binding HasDimensions, Converter={StaticResource BoolToVisible}}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Dimensions}" Style="{StaticResource DetailValue}" Visibility="{Binding HasDimensions, Converter={StaticResource BoolToVisible}}" />
                                            <TextBlock Grid.Row="3" Text="Created" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Created}" Style="{StaticResource DetailValue}" />
                                            <TextBlock Grid.Row="4" Text="Modified" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Modified}" Style="{StaticResource DetailValue}" />
                                            <TextBlock Grid.Row="5" Text="Location" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Location}" Style="{StaticResource DetailValue}" Foreground="{StaticResource Muted}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
